# Modèle de configuration locale. Copie ce fichier en `.env` et renseigne tes valeurs.
# `.env` n'est PAS versionné (voir .gitignore).

# Vérification SSL des appels sortants (NHL, ESPN, PuckPedia).
# Mets "false" UNIQUEMENT sur une machine dont le réseau inspecte le HTTPS
# (proxy d'entreprise Zscaler/Netskope, erreur « self-signed certificate in
# certificate chain »). Laisse "true" partout ailleurs.
VERIFY_SSL=true

# Identifiants ESPN (optionnels — sans eux, les fonctions liées au pool restent
# vides). Voir README « Configurer ESPN ».
ESPN_LEAGUE_ID=12957
ESPN_SEASON=2026
ESPN_TEAM_ID=12
ESPN_SWID={ton_swid}
ESPN_S2=ta_valeur_espn_s2
