# Secrets locaux Streamlit (ne jamais committer)
.streamlit/secrets.toml

# Config locale (secrets ESPN + VERIFY_SSL propre à la machine) — voir .env.example
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS / éditeurs
.DS_Store
Thumbs.db
.vscode/
.idea/

# Scripts de test temporaires
test_*.py
blob.json

# Overrides LOCAUX (tests) — ne JAMAIS committer. La référence officielle est le
# fichier sans « .local » (committé, lu par le Cloud) : player_status.json,
# draft_plan.json, lineup.json, draft_settings.json. Voir cloud_store.py.
*.local.json

# Données ESPN (rosters du pool) — rafraîchies à chaque ouverture de l'app, donc
# regénérées automatiquement. Ignorées pour ne pas polluer la référence git
# pendant les tests locaux.
espn*.json

